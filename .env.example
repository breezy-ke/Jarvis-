# Copy to .env and fill in. Never commit .env.

# ─── Required for Phase 1 (the brain) ───────────────────────────────────────

# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Supabase → Project Settings → Database → Connection string (URI).
# Use the pooled connection string for a deployed brain.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Encrypts OAuth refresh tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this invalidates every stored account connection.
ENCRYPTION_KEY=

# One-time secret the phone presents to register itself as a trusted device.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DEVICE_BOOTSTRAP_SECRET=

# ─── Optional ───────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development

# IANA timezone Jarvis reasons in by default.
TIMEZONE=Africa/Nairobi

# Public origin of the brain — used to build the OAuth redirect URI.
PUBLIC_BASE_URL=http://localhost:3000

# ─── Phase 2: Google (leave blank until then) ───────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
