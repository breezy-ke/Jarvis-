# Ekusi Lore supporter register — environment
# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------- Supabase
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Project settings → API → service_role.
# Bypasses row level security. Server-side only. If this ever reaches a browser
# bundle, the entire supporter register is readable by anyone.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------------- crypto
# Server-side pepper mixed into OTP hashes so database read access alone cannot
# verify a pending registration. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this invalidates every outstanding code.
OTP_PEPPER=

# --------------------------------------------------------------------- site
# The site's address — campaign pages and the register alike, since they are one
# application now. Used for canonical URLs, the sitemap, robots and social
# preview links. No subdomain: the register is the /join route.
NEXT_PUBLIC_SITE_URL=https://ekusilore.co.ke

# NEXT_PUBLIC_MAIN_SITE_URL used to point the register's header back at a
# separate WordPress site. Both halves are the same app now and every link
# between them is a route, so the variable is gone. Delete it from any .env
# file that still carries it — nothing reads it.

# ------------------------------------------------------------- SMS (Africa's Talking)
# See docs/africas-talking-setup.md for the full walkthrough.
#
# TESTING (works today, free, no shortcode needed):
#   AT_USERNAME=sandbox
#   AT_API_KEY=<your sandbox API key>
#   AT_SENDER_ID=            ← leave BLANK for sandbox
#
# LIVE (once your production API key and sender ID/shortcode are approved):
#   AT_USERNAME=<your production username>
#   AT_API_KEY=<your production API key>
#   AT_SENDER_ID=<your approved shortcode or alphanumeric ID>
#
# Leave all three BLANK in local dev and the app prints codes to the server
# console instead of sending. It refuses to fake delivery in production.
#
# IMPORTANT: leave AT_SENDER_ID blank until your sender ID is actually approved.
# Africa's Talking blocks an unapproved sender, so an early value breaks sending.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ------------------------------------------------------------------- import
# Labels the register edition recorded against imported polling stations.
AKIYAR_REGISTER_EDITION=2022-general
