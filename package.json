{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "description": "Personal AI assistant — voice-driven, Claude-powered, account-connected",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace @jarvis/brain",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @jarvis/brain",
    "db:push": "npm run db:push --workspace @jarvis/brain"
  }
}
